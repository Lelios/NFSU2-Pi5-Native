+typedef struct RecompCpu {
+    uint32_t r_eax, r_ecx, r_edx, r_ebx, r_esp, r_esi, r_edi, r_ebp;   /* RECOMP_REGS_OUT order; r_ prefix: eax.. are macros with RECOMP_LOCAL_REGS */
