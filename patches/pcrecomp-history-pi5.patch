+            return [f"wrm64({self.addr(d)}, g_xmm[{self.idx(s)}].u64[{lane}]);"]
+        if m == "movhlps":
+            return [f"g_xmm[{self.idx(d)}].u64[0] = g_xmm[{self.idx(s)}].u64[1];"]
+        if m == "movlhps":
+            return [f"g_xmm[{self.idx(d)}].u64[1] = g_xmm[{self.idx(s)}].u64[0];"]
