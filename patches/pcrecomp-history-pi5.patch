@@ -27,6 +27,41 @@ from typing import Optional, List, Dict, Tuple
 
 # ---------------------------------------------------------------------------
 # Dataclasses
+
+def _code_range(info, code_sections):
+    """[start, end) of the code, as VAs.
+
+    min..max over every executable section is only right while those sections
+    are adjacent. A dumped/unpacked executable often ends with a small
+    executable section of its own (a rebuilt import directory, an unpacker
+    stub) far past the data, and min..max then spans .rdata/.data/.rsrc as if
+    they were code: NFS Underground 2's SPEED2.EXE has .text at 0x401000 and an
+    8 KB executable import section at 0x930000, which made 1.7 MB of data
+    "code" for every scan downstream.
+
+    So group the code sections into runs with no non-code section between
+    them, and take the run holding the entry point (the largest run if the
+    entry point is in none of them).
+    """
+    ordered = sorted(info.sections, key=lambda s: s.virtual_address)
+    runs, cur = [], []
+    for s in ordered:
+        if s in code_sections:
+            cur.append(s)
+        elif cur:
+            runs.append(cur); cur = []
+    if cur:
+        runs.append(cur)
+    ep = info.entry_point_rva
+    pick = None
+    for r in runs:
+        if r[0].virtual_address <= ep < r[-1].va_end:
+            pick = r
+    if pick is None:
+        pick = max(runs, key=lambda r: r[-1].va_end - r[0].virtual_address)
+    return (info.image_base + pick[0].virtual_address,
+            info.image_base + pick[-1].va_end)
+
 # ---------------------------------------------------------------------------
 
